# Để trống 2 biến dưới đây => app chạy ở CHẾ ĐỘ DEMO (dữ liệu lưu trong localStorage của trình duyệt).
# Điền giá trị từ Supabase Dashboard → Project Settings → API để chạy với database thật.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL công khai của site (dùng để tạo link khảo sát / QR). Để trống = window.location.origin
VITE_PUBLIC_SITE_URL=
